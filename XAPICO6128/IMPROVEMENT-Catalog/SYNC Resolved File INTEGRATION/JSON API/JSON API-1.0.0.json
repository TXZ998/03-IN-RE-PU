            "description": "Unique Cargospot internal ID for the flight schedule alert.",
            "example": 123456
          },
          "alertType": {
            "type": "string",
            "description": "The alertType code of should be existing in Cargospot master data."
          },
          "alertLevel": {
            "type": "string",
            "description": "Category of the flight schedule alertlevel Values include F-Flight, S-Schedule.",
            "example": "F"
          },
          "sendOnManual": {
            "type": "boolean",
            "description": "Checkbox to with default unchecked state.",
            "example": true
          },
          "email": {
            "type": "string",
            "description": "Email address for to send flight schedule alert.",
            "example": "xyz@champ.aero"
          }
        }
      },
