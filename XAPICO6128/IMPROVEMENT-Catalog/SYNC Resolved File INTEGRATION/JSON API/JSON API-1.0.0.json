  "components": {
    "schemas": {
      "FlightAlert": {
        "required": [
          "alert type",
          "alert level",
          "email",
          "sendOnManual"
        ],
        "properties": {
          "alertType": {
            "description": "Drop down Selection for type of alert for flight alert.",
            "example": "D,E,F,N,R,T,C,I"
          },
          "alertLevel": {
            "description": "Drop down Selection for type of alert level for flight alert.",
            "example": "F,S"
          },
          "email": {
            "type": "string",
            "description": "Multiple email id allowed to send Flight schedule alert.",
            "example": "xyz@c.com"
          },
          "sendOnManual": {
            "type": "boolean",
            "description": "Option check box with default unchecked state.",
            "example": "Y,N"
          }
        }
      },
