            }
          },
          "alertLevel": {
            "type": "string",
            "items": {
              "type": "string",
              "description": "Users can search and filter Flight Alerts using the following parameters F=Flight;S=Schedule.",
              "example": "F"
            }
          },
          "email": {
            "type": "array",
            "items": {
