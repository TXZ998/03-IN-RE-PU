              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "today special"
                    },
                    "description": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string",
                      "example": "../resource/image/image1.jpeg"
                    },
                    "price": {
                      "type": "string",
                      "example": "20.50"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Item"
                      }
                    }
                  },
                  "additionalProperties": {
                    "street": {
                      "type": "string",
                      "example": "437 Lytton"
                    },
                    "city": {
                      "type": "string",
                      "example": "Palo Alto"
                    },
                    "state": {
                      "type": "string",
                      "example": "CA"
                    },
                    "zip": {
                      "type": "string",
                      "example": "94301"
                    }
                  }
                }
              }
            },
            "headers": {
              "location": {
                "description": "URL of created resource",
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
